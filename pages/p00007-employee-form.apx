page 7 (
    name: Employee_form
    alias: EMPLOYEE-FORM
    title: Employee_form
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region employee-form (
        name: Employee_form
        type: form
        source {
            location: localDatabase
            tableName: EMP_SAS
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P7_DEPTNO (
        type: selectList
        label {
            label: Deptno
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @dept-dname
        }
        layout {
            sequence: 40
            region: @employee-form
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @employee-form
            column: DEPTNO
            dataType: number
        }
    )

    pageItem P7_ENO (
        type: textField
        label {
            label: Eno
            alignment: left
        }
        layout {
            sequence: 10
            region: @employee-form
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @employee-form
            column: ENO
            dataType: number
            primaryKey: true
        }
    )

    pageItem P7_MSG (
        type: displayOnly
        label {
            label: Msg
            alignment: left
        }
        layout {
            sequence: 50
            region: @employee-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P7_NAME (
        type: textField
        label {
            label: Name
            alignment: left
        }
        layout {
            sequence: 20
            region: @employee-form
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 50
        }
        source {
            formRegion: @employee-form
            column: NAME
            dataType: varchar2
        }
    )

    pageItem P7_SAL (
        type: numberField
        label {
            label: Sal
            alignment: left
        }
        layout {
            sequence: 30
            region: @employee-form
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @employee-form
            column: SAL
            dataType: number
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @employee-form
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 6
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @employee-form
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P7_ENO
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @employee-form
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P7_ENO
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @employee-form
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P7_ENO
        }
    )

    dynamicAction dup-chk (
        name: Dup_chk
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P7_ENO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        v_count NUMBER;
                    BEGIN
                        SELECT COUNT(*)
                          INTO v_count
                          FROM emp_sas
                         WHERE eno = :P7_ENO;
                    
                        IF v_count > 0 THEN
                            :P7_MSG := 'Employee number already exists';
                        ELSE
                            :P7_MSG := 'VALID';
                        END IF;
                    END;
                    ```
                itemsToSubmit: P7_ENO
                itemsToReturn: P7_MSG
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var eno = $v("P7_ENO");
                    var msg = $v("P7_MSG");
                    
                    if (msg !== "VALID") {
                      apex.message.alert(
                        "Duplicate ENO",
                        function () {
                            setTimeout(function () {
                                apex.item("P7_ENO").setFocus();
                            }, 100);
                        }
                    );
                    }
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    process initialize-form-employee-form (
        name: Initialize form Employee_form
        type: formInitialization
        formRegion: @employee-form
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 1848693894710871279
        }
    )

    process process-form-employee-form (
        name: Process form Employee_form
        type: formAutoRowProcessing
        formRegion: @employee-form
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1848694259785871279
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 6
            }
        }
    )

)

